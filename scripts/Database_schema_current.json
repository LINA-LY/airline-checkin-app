          "pricing_summary": { "ECONOMY": { "price": 180, "seatsAvailable": 120 }, "BUSINESS": { "price": 450, "seatsAvailable": 12 }, "meta": { "currency": "USD", "carryOnIncluded": 1 } },
          "stops": 0,
          "checked_bags_included": 1,
          "emissions_kg": 160,
          "duration_minutes": 110,
          "generated": true
        },
        {
          "id": 2,
          "flight_number": "AH1002",
          "origin": "ALG",
          "destination": "ORY",
          "date_key": "2026-06-01",
          "route_key": "ALG_ORY",
          "airline": "SkyConnect",
          "aircraft_id": 1,
          "carry_on_included": 1,
          "pricing_summary": { "ECONOMY": { "price": 140, "seatsAvailable": 120 }, "BUSINESS": { "price": 350, "seatsAvailable": 12 }, "meta": { "currency": "USD", "carryOnIncluded": 1 } },
          "stops": 1,
          "checked_bags_included": 0,
          "emissions_kg": 190,
          "duration_minutes": 125,
          "generated": true
        }
      ]
    },
    {
      "name": "airports",
      "columns": [
        { "name": "code", "type": "varchar", "constraints": ["primary key"] },
        { "name": "name", "type": "varchar" },
        { "name": "city", "type": "varchar" },
        { "name": "country", "type": "varchar" },
        { "name": "region", "type": "varchar", "note": "Maps to regions.code for continent/region grouping (see regions table)" }
      ],
      "records": [
        {
          "code": "ALG",
          "name": "Algiers International Airport",
          "city": "Algiers",
          "country": "Algeria",
          "region": "NORTH_AFRICA"
        }
      ]
    },
    {
      "name": "regions",
      "columns": [
        { "name": "code", "type": "varchar", "constraints": ["primary key"] },
        { "name": "name", "type": "varchar" },
        { "name": "description", "type": "varchar" }
      ],
      "records": [
        { "code": "NORTH_AMERICA", "name": "North America", "description": "USA/Canada/Mexico and nearby" },
        { "code": "SOUTH_AMERICA", "name": "South America", "description": "All South American countries" },
        { "code": "NORTH_AFRICA", "name": "North Africa", "description": "Northern half of Africa (e.g., Algeria, Morocco, Tunisia)" },
        { "code": "SOUTHERN_AFRICA", "name": "Southern Africa", "description": "Southern half of Africa" },
        { "code": "EUROPE", "name": "Europe", "description": "European continent" },
        { "code": "MIDDLE_EAST", "name": "Middle East", "description": "Middle Eastern countries" },
        { "code": "CENTRAL_SOUTH_ASIA", "name": "Central / Southern Asia", "description": "India, Pakistan, Central Asia, etc." },
        { "code": "EAST_ASIA_SE_ASIA", "name": "East Asia + SE Asia", "description": "China, Japan, Korea, SE Asia" },
        { "code": "OCEANIA", "name": "Oceania", "description": "Australia, New Zealand, Pacific islands" }
      ]
    },
    {
      "name": "flight_stops",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "flight_id", "type": "integer" },
        { "name": "stop_sequence", "type": "integer" },
        { "name": "airport_code", "type": "varchar" },
        { "name": "layover_minutes", "type": "integer" },
        { "name": "arrival_time", "type": "timestamp" },
        { "name": "departure_time", "type": "timestamp" }
      ],
      "records": []
    },
    {
      "name": "aircrafts",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "model", "type": "varchar" },
        { "name": "manufacturer", "type": "varchar" },
        { "name": "seat_map", "type": "json", "note": "JSON seat layout: rows, columns, classes, seat labels" },
        { "name": "seats_total", "type": "integer" }
      ],
      "records": [
        { "id": 1, "model": "A320", "manufacturer": "Airbus", "seat_map": {"rows":30,"layout":"3-3","classes":{"Business":{"rows":[1,2]},"Economy":{"rows":[10,30]} }}, "seats_total":156 }
      ]
    },
    {
      "name": "bookings",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "pnr", "type": "varchar", "constraints": ["unique"], "note": "Booking Reference (6 chars)" },
        { "name": "user_id", "type": "integer" },
        { "name": "flight_id", "type": "integer" },
        { "name": "status", "type": "varchar", "note": "Confirmed, Cancelled" },
        { "name": "tickets_count", "type": "integer" },
        { "name": "total_price", "type": "integer" },
        { "name": "currency", "type": "varchar" },
        { "name": "payment_status", "type": "varchar" },
        { "name": "cabin_class", "type": "varchar" }
      ],
      "records": [
        {
          "id": 1,
          "pnr": "ABCDEF",
          "user_id": 1,
          "flight_id": 1,
          "status": "Confirmed",
          "tickets_count": 1,
          "total_price": 120,
          "currency": "USD",
          "payment_status": "PAID",
          "cabin_class": "ECONOMY"
        },
        {
          "id": 2,
          "pnr": "XYZ123",
          "user_id": 2,
          "flight_id": 2,
          "status": "Confirmed",
          "tickets_count": 2,
          "total_price": 240,
          "currency": "USD",
          "payment_status": "PAID",
          "cabin_class": "BUSINESS"
        }
      ]
    },
    {
      "name": "passengers",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "booking_id", "type": "integer" },
        { "name": "user_id", "type": "integer", "note": "Nullable link back to the logged-in user who owns the passenger profile" },
        { "name": "first_name", "type": "varchar" },
        { "name": "last_name", "type": "varchar" },
        { "name": "passport_number", "type": "varchar", "note": "Extracted via OCR" },
        { "name": "passport_expiry", "type": "date" },
        { "name": "nationality", "type": "varchar" }
      ],
      "records": [
        { "id": 1, "booking_id": 1, "user_id": 1, "first_name": "Alice", "last_name": "Smith", "passport_number": "P9876543" },
        { "id": 2, "booking_id": 2, "user_id": 2, "first_name": "Bob", "last_name": "Jones", "passport_number": "P1234567" }
      ]
    },
    {
      "name": "seats",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "flight_id", "type": "integer" },
        { "name": "seat_number", "type": "varchar" },
        { "name": "seat_class", "type": "varchar", "note": "ECONOMY, PREMIUM_ECONOMY, BUSINESS" },
        { "name": "reserved", "type": "boolean", "note": "Only store rows when a seat is reserved or assigned; availability is derived from the aircraft seat map plus reservations" },
        { "name": "passenger_id", "type": "integer", "note": "If assigned, references passengers.id" }
      ],
      "records": [
        { "id": 1, "flight_id": 1, "seat_number": "12A", "seat_class": "ECONOMY", "reserved": true, "passenger_id": 1 }
      ]
    },
    {
      "name": "check_ins",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "passenger_id", "type": "integer", "constraints": ["unique"] },
        { "name": "seat_id", "type": "integer", "note": "Nullable if not selected yet" },
        { "name": "dietary_preference", "type": "varchar" },
        { "name": "assistance_needs", "type": "varchar" },
        { "name": "infant_pet_declaration", "type": "varchar" },
        { "name": "is_completed", "type": "boolean" },
        { "name": "sync_status", "type": "varchar", "note": "Enum: SYNCED, PENDING_UPDATE" },
        { "name": "last_updated", "type": "timestamp", "note": "For conflict resolution" }
      ],
      "records": [
        { "id": 1, "passenger_id": 1, "seat_id": 1, "is_completed": true, "sync_status": "PENDING_UPDATE" }
      ]
    },
    {
      "name": "boarding_passes",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "check_in_id", "type": "integer", "constraints": ["unique"] },
        { "name": "qr_code_data", "type": "varchar" },
        { "name": "sync_status", "type": "varchar", "note": "Enum: SYNCED, PENDING_UPDATE" },
        { "name": "last_updated", "type": "timestamp" }
      ],
      "records": [
        { "id": 1, "check_in_id": 1, "qr_code_data": "QR_DATA_ALICE_12A", "sync_status": "PENDING_UPDATE" }
      ]
    },
    {
      "name": "baggage_declarations",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "booking_id", "type": "integer" },
        { "name": "carry_on_included", "type": "integer" },
        { "name": "cabin_bags", "type": "integer" },
        { "name": "checked_bags", "type": "integer" },
        { "name": "special_items", "type": "varchar" }
      ],
      "records": [
        { "id": 1, "booking_id": 1, "carry_on_included": 1, "cabin_bags": 1, "checked_bags": 0, "special_items": "" }
      ]
    }
  ],
  "relationships": [
    { "from": "bookings.user_id", "to": "users.id", "type": "many-to-one" },
    { "from": "bookings.flight_id", "to": "flights.id", "type": "many-to-one" },
    { "from": "flights.origin", "to": "airports.code", "type": "many-to-one" },
    { "from": "flights.destination", "to": "airports.code", "type": "many-to-one" },
    { "from": "passengers.booking_id", "to": "bookings.id", "type": "many-to-one" },
    { "from": "passengers.user_id", "to": "users.id", "type": "many-to-one" },
    { "from": "check_ins.passenger_id", "to": "passengers.id", "type": "one-to-one" },
    { "from": "check_ins.seat_id", "to": "seats.id", "type": "one-to-one" },
    { "from": "boarding_passes.check_in_id", "to": "check_ins.id", "type": "one-to-one" },
    { "from": "baggage_declarations.booking_id", "to": "bookings.id", "type": "many-to-one" }
  ]
}
