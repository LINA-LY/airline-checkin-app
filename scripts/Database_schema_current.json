{
  "tables": [
    {
      "name": "users",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "name", "type": "varchar" },
        { "name": "email", "type": "varchar", "constraints": ["unique"] },
        { "name": "phone", "type": "varchar" },
        { "name": "password_hash", "type": "varchar" },
        { "name": "google_id", "type": "varchar", "note": "For Google quick sign-in" }
      ],
      "records": [
        { "id": 1, "name": "Alice Smith", "email": "alice@example.com", "google_id": "g_12345" },
        { "id": 2, "name": "Bob Jones", "email": "bob@example.com", "google_id": null }
      ]
    },
    {
      "name": "flights",
      "columns": [
        { "name": "id", "type": "integer", "constraints": ["primary key"] },
        { "name": "flight_number", "type": "varchar" },
        { "name": "origin", "type": "varchar" },
        { "name": "destination", "type": "varchar" },
        { "name": "departure_time", "type": "timestamp" },
        { "name": "arrival_time", "type": "timestamp" },
        { "name": "date_key", "type": "date", "note": "YYYY-MM-DD" },
        { "name": "route_key", "type": "varchar", "note": "origin_destination unique per day" },
        { "name": "aircraft_type", "type": "varchar" },
        { "name": "seats_total", "type": "integer" },
        { "name": "seats_by_type", "type": "json" },
        { "name": "generated", "type": "boolean" },
        { "name": "created_at", "type": "timestamp" }
      ],
      "records": [
        {
          "id": 1,
          "flight_number": "AH1000",
          "origin": "ALG",
          "destination": "CDG",
          "date_key": "2026-06-01",
